# Copy this file to .env on your own server; never commit .env.
BASE_URL=https://party.example.com
PARTY_PORT=8787
# Set to 1 only when Caddy / another trusted proxy is the sole public entry point.
TRUST_PROXY=1
ALLOWED_ORIGINS=https://web.stremio.com
MAX_ROOMS=200
MAX_PEERS=16
RELEASES_URL=https://github.com/example/open-stremio-party/releases

{
  "manifest_version": 3,
  "name": "Open Stremio Party",
  "short_name": "Watch Party",
  "description": "Watch together on Stremio Web with a self-hosted party server.",
  "version": "0.1.2",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Watch Party"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.stremio.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
